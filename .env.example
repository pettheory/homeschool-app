# ── API Keys (Phase 4 — real voice/AI engines; never sent to the browser) ──
# Fill in only the engine(s) you want to turn on. With a key absent, that engine
# falls back to the simulated/browser behaviour, so the app always runs.
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# GOOGLE_STT_API_KEY is OPTIONAL and unused by the current build. STT (hearing the
# child) is done by the browser Web Speech API; if we wire real STT later, OpenAI
# Realtime (your OPENAI_API_KEY) is the planned path. Only fill this if you
# specifically want Google Cloud Speech-to-Text (Chirp). NB: this is NOT Gemini —
# it's a separate Google product with its own key.
GOOGLE_STT_API_KEY=

# ── Models (current as of 2026-06; override if you prefer) ──
# Engine C judge model:  gpt-5.4-nano (OpenAI)  |  gemini-3.1-flash-lite (Google)
TEXT_PROCESSING_MODEL=gpt-5.4-nano
# OpenAI Realtime voice model (Engine A/B): gpt-realtime-2 | gpt-realtime
REALTIME_MODEL=gpt-realtime-2
# Speech-to-text model for /api/transcribe (test harness): gpt-4o-transcribe | whisper-1
STT_MODEL=gpt-4o-transcribe
# ElevenLabs TTS model (Bolt's voice). Quality↔latency tradeoff:
#   eleven_multilingual_v2 (life-like, default) | eleven_v3 (most expressive) |
#   eleven_turbo_v2_5 / eleven_flash_v2_5 (lower latency, plainer)
ELEVENLABS_MODEL=eleven_multilingual_v2
# ElevenLabs voice for Bolt. Curated warm/kid-friendly options:
#   cgSgspJ2msm6clMCkdW9 = Jessica (playful, bright, warm — default)
#   FGY2WhTYpPnrIDTdsKH5 = Laura (energetic)   Xb7hH8MSUJpSbSDYk0k2 = Alice (clear educator)
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# ── Session Config ──
# Default engine: A (Realtime all-in-one) | B (Realtime + client parse) | C (Split pipeline)
ACTIVE_APPROACH=B
# reading | spelling | mixed
WORD_LIST_MODE=mixed

# ── Server ──
# Backend API port (kept separate from PORT so it never collides with the Vite
# dev server or a host that injects PORT). The Vite proxy targets localhost:3001.
SERVER_PORT=3001
