# ── API Keys (Phase 4 — real voice/AI engines; never sent to the browser) ──
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_STT_API_KEY=

# ── Session Config ──
# Default engine: A (Realtime all-in-one) | B (Realtime + client parse) | C (Split pipeline)
ACTIVE_APPROACH=B
# Engine C judge model: gpt-5.4-nano | gemini-3.1-flash-lite
TEXT_PROCESSING_MODEL=gpt-5.4-nano
# reading | spelling | mixed
WORD_LIST_MODE=mixed

# ── Server ──
PORT=3001
